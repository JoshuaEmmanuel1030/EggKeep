# Copy to .env for local development. All values are safe to expose to the
# browser (publishable/anon keys only — never put a service-role key here).

# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sentry error monitoring (optional — app runs fine without it).
# Leave empty locally; set in Vercel project settings for production.
# See docs/OPERATIONS.md for setup steps.
VITE_SENTRY_DSN=
